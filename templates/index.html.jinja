<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@300;400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="static/style.css">
</head>
<body>
<div class="grain"></div>

<header class="site-header">
  <a class="site-mark" href="#top">elkino Studio</a>
  <nav class="site-nav" aria-label="Primary navigation">
    <a href="#worlds">Worlds</a>
    <a href="#about">About</a>
    <a href="#mono-japan">Latest film <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<main id="top">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="eyebrow">Independent creative practice · Japan</p>
      <h1 class="hero__title" id="hero-title">films, music, stories,<br>and other worlds.</h1>
    </div>
    <div class="hero__orbit" aria-hidden="true">
      <span class="orbit orbit--outer"></span>
      <span class="orbit orbit--middle"></span>
      <span class="orbit orbit--inner"></span>
      <span class="orbit__point"></span>
    </div>
    <a class="hero__link" href="#threshold">
      <span>Enter the worlds</span><span aria-hidden="true">↓</span>
    </a>
  </section>

  <section class="threshold" id="threshold">
    <p class="threshold__label">Threshold</p>
    <p class="threshold__statement reveal">Not a collection of works.<br>A passage between worlds.</p>
  </section>

  <section class="world" id="worlds" aria-labelledby="mono-japan-title">
    <div class="world__meta">
      <span>01</span>
      <span>Films / Documentary</span>
    </div>

    <div class="world__intro" id="mono-japan">
      <h2 class="world__title" id="mono-japan-title">mono Japan</h2>
      <p class="world__statement">To look at Japan is to look at culture itself.</p>
    </div>

    <div class="films">
      {% for video in mono_japan_videos %}
      <article class="film reveal{% if loop.first %} film--featured{% endif %}">
        <a class="film__link" href="{{ video.url }}" target="_blank" rel="noopener">
          <figure class="film__visual">
            {% if video.thumbnail %}
            <img src="{{ video.thumbnail }}" alt=""{% if not loop.first %} loading="lazy"{% endif %}>
            {% endif %}
          </figure>
          <div class="film__details">
            <p class="film__number">{{ "%02d"|format(loop.index) }}</p>
            <h3 class="film__title">{{ video.title }}</h3>
            <span class="film__arrow" aria-hidden="true">↗</span>
          </div>
        </a>
      </article>
      {% else %}
      <p class="empty">Films will appear here when the next update is available.</p>
      {% endfor %}
    </div>
  </section>
</main>

<script src="static/script.js"></script>
</body>
</html>
