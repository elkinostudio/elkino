<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.description }}">
<link rel="stylesheet" href="static/style.css">
</head>
<body>
<header class="site-header">
  <a class="site-mark" href="#top">elkino studio</a>
  <nav class="site-nav" aria-label="Primary navigation">
    <a href="#mono-japan">Films</a>
    <a href="#music">Music</a>
    <a href="#stories">Stories</a>
    <a href="#web-lab">Web / Lab</a>
    <a href="#about">About</a>
  </nav>
</header>

<main id="top">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__identity">
      <h1 class="hero__title" id="hero-title"><span>elkino</span><span>studio</span></h1>
      <p class="hero__eyebrow">Independent creative practice · Japan</p>
    </div>
    <p class="hero__description">films, music, stories,<br>and other worlds.</p>
    <a class="hero__enter" href="#threshold">Enter</a>
    <div class="hero__circle" aria-hidden="true"></div>
  </section>

  <section class="threshold" id="threshold" aria-label="Threshold">
    <p>Not a collection of works.<br>A passage between worlds.</p>
  </section>

  <section class="mono-japan" id="mono-japan" aria-labelledby="mono-japan-title">
    <div class="section-meta"><span>01</span><span>Films / Documentary</span></div>

    {% set latest = mono_japan_videos|first %}
    {% if latest %}
    <a class="latest-visual" href="{{ latest.url }}" target="_blank" rel="noopener" aria-label="Watch {{ latest.title }} on YouTube">
      {% if latest.thumbnail %}<img src="{{ latest.thumbnail }}" alt="">{% endif %}
    </a>
    {% else %}
    <div class="latest-visual latest-visual--empty" aria-hidden="true"></div>
    {% endif %}

    <h2 class="mono-japan__title" id="mono-japan-title">mono Japan</h2>

    <div class="mono-japan__copy">
      <p class="mono-japan__statement">To look at Japan is to look at culture itself.</p>
      <p class="mono-japan__description">Films about language, sound, design, custom and philosophy —<br>quiet observations made for viewers beyond Japan.</p>
      <a class="text-link" href="https://www.youtube.com/@mono_Japan" target="_blank" rel="noopener">Enter mono Japan <span aria-hidden="true">↗</span></a>
    </div>

    {% if latest %}<p class="latest-title">Latest film · {{ latest.title }}</p>{% endif %}
  </section>
</main>
</body>
</html>
